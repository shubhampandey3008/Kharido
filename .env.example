# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...           # Primary reasoning model (Claude)

# ── Web Search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...                # Criteria Research Agent web search

# ── Product / Review Scraping ─────────────────────────────────────────────────
SCRAPINGBEE_API_KEY=...                # ScrapingBee (free tier ~1000 credits)

# ── Tracing ───────────────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=ls__...              # LangSmith project tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=kharido-dev

# ── Preference Memory (V2) ────────────────────────────────────────────────────
MEM0_API_KEY=...                       # Leave blank to use local mode in V2

# ── Application ───────────────────────────────────────────────────────────────
KHARIDO_ENV=development
KHARIDO_LOG_LEVEL=INFO
KHARIDO_CACHE_DIR=.cache/kharido
KHARIDO_DB_PATH=.cache/kharido.db
KHARIDO_OFFLINE_DATASET_DIR=data/offline_dataset

# ── Model Selection ───────────────────────────────────────────────────────────
KHARIDO_REASONING_MODEL=claude-sonnet-4-6
KHARIDO_EXTRACTION_MODEL=claude-haiku-4-5-20251001
